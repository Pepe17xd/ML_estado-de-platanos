{
  "schema_version": 1,
  "experiment": "banana_ai_system_v3_lighting_e1",
  "seed": 2026,
  "classes": ["verde", "maduro", "sobre_maduro", "podrido"],
  "input_size": [224, 224],
  "v2_checkpoint": "models/production_model_v2.keras",
  "v2_metadata": "models/metadata.json",
  "dataset_dir": "data/dataset_v2",
  "manifest": "data/dataset_v2/manifest.csv",
  "augmentation": {
    "seed": 2026,
    "max_photometric_ops": 2,
    "geometric": {
      "horizontal_flip": true,
      "rotation_factor": 0.08,
      "zoom_factor": 0.12
    },
    "photometric": {
      "brightness": {"enabled": true, "probability": 0.25, "delta": 14.0},
      "contrast": {"enabled": false, "probability": 0.25, "factor_range": [0.9, 1.1]},
      "gamma": {"enabled": true, "probability": 0.20, "range": [0.9, 1.1]},
      "saturation": {"enabled": true, "probability": 0.20, "range": [0.9, 1.1]},
      "white_balance": {"enabled": true, "probability": 0.15, "gain_range": [0.96, 1.04]},
      "shadow": {
        "enabled": true,
        "probability": 0.15,
        "strength_range": [0.10, 0.22],
        "radius_range": [0.18, 0.38],
        "softness": 0.10
      }
    }
  },
  "training": {
    "batch_size": 32,
    "epochs_head": 8,
    "epochs_finetune": 8,
    "learning_rate_head": 0.001,
    "learning_rate_finetune": 0.00001,
    "weight_decay": 0.00001,
    "fine_tune_last_layers": 30,
    "early_stopping_patience": 3,
    "class_weights": "max_count_over_class_count"
  },
  "selection": {
    "primary_metric": "macro_f1",
    "min_rotten_recall": 0.80,
    "rotten_as_maduro_alert_rate": 0.15,
    "tie_breakers": ["rotten_recall", "balanced_accuracy"]
  }
}
